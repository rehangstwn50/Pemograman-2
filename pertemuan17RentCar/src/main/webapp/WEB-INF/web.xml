<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>RentCar System</display-name>

    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <!-- Session timeout 30 menit -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Filter auth -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.rentcar.util.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>*.jsp</url-pattern>
    </filter-mapping>

    <!-- Servlet mappings -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.rentcar.controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MobilServlet</servlet-name>
        <servlet-class>com.rentcar.controller.MobilServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MobilServlet</servlet-name>
        <url-pattern>/mobil</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CustomerServlet</servlet-name>
        <servlet-class>com.rentcar.controller.CustomerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CustomerServlet</servlet-name>
        <url-pattern>/customer</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SewaServlet</servlet-name>
        <servlet-class>com.rentcar.controller.SewaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SewaServlet</servlet-name>
        <url-pattern>/sewa</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>KembaliServlet</servlet-name>
        <servlet-class>com.rentcar.controller.KembaliServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>KembaliServlet</servlet-name>
        <url-pattern>/kembali</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LaporanServlet</servlet-name>
        <servlet-class>com.rentcar.controller.LaporanServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LaporanServlet</servlet-name>
        <url-pattern>/laporan</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.rentcar.controller.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.rentcar.controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

</web-app>
